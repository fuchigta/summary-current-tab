  },
  "dependencies": {
    "@langchain/core": "^1.5.1",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/openai": "^1.8.5",
    "@plasmohq/storage": "^1.13.0",
    "@types/turndown": "^5.0.5",
    "langchain": "^1.6.7",
    "marked": "^15.0.6",
    "plasmo": "0.89.4",
    "postcss": "^8.5.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^3.4.17",
    "turndown": "^7.2.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "31.0.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^5.1.1"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
